# Database (Postgres container on the VPS, see docker-compose.yml)
DATABASE_URL="postgresql://paconia:change_me@db:5432/paconia?schema=public"
# Login sessions: generate with  openssl rand -base64 32
AUTH_SECRET="change_me_long_random_string"
# Public address of the site
NEXT_PUBLIC_SITE_URL="https://paconia.in"
# Razorpay (start with test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"
# 1 = show a "simulate payment" button instead of Razorpay (testing only, never in production)
PAYMENTS_DEMO="0"
# Where uploaded artwork and proofs are stored (a Docker volume on the VPS)
UPLOAD_DIR="/app/uploads"
# First owner account, created by the seed
OWNER_EMAIL="owner@paconia.in"
OWNER_PASSWORD="ChangeMe@123"
# 1 = also load demo customers, orders and stock (for trying the app; leave 0 for a clean start)
SEED_DEMO="0"
