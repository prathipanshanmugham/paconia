generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people

enum Role {
  CUSTOMER
  OWNER
  MANAGER
  DESIGNER
  OPERATOR
  ACCOUNTS
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         Role       @default(CUSTOMER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  customer     Customer?
  activity     Activity[]
  apiKeys      ApiKey[]
}

enum ApiAccess {
  READ
  WRITE
}

/// Keys that let Claude (over MCP) or a script act as one team member. Only a hash of the key is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  hash       String    @unique
  access     ApiAccess @default(READ)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  uses       Int       @default(0)
  revokedAt  DateTime?
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

model Customer {
  id          String       @id @default(cuid())
  code        String       @unique
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        CustomerType @default(INDIVIDUAL)
  name        String
  company     String?
  phone       String
  email       String?
  gstin       String?
  line1       String?
  line2       String?
  city        String?
  state       String?
  stateCode   String?
  pincode     String?
  creditDays  Int          @default(0)
  creditLimit Decimal      @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime     @default(now())
  orders      Order[]
  quotes      Quote[]
  invoices    Invoice[]
  payments    Payment[]
  enquiries   Enquiry[]
}

// ---------------------------------------------------------------- catalogue

enum ProductFamily {
  LABELS
  PACKAGING
  POUCHES
  CARDS
  LASER
}

enum PricingModel {
  SHEET
  POUCH
  LASER
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  family      ProductFamily
  tagline     String
  description String
  model       PricingModel
  shape       String
  hsn         String
  gstRate     Int
  leadDays    Int           @default(3)
  active      Boolean       @default(true)
  featured    Boolean       @default(false)
  sort        Int           @default(0)
  config      Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  quoteLines  QuoteLine[]
  cartLines   CartLine[]
  photos      FileAsset[]
}

enum MaterialCategory {
  MEDIA
  BLANK
  LASER
  TONER
  FILM
  CONSUMABLE
  PACKING
}

model Material {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  category     MaterialCategory
  uom          String
  sheetW       Int?
  sheetH       Int?
  colour       String?
  needsWhite   Boolean          @default(false)
  cost         Decimal          @db.Decimal(10, 2)
  price        Decimal          @db.Decimal(10, 2)
  onHand       Decimal          @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal          @default(0) @db.Decimal(12, 2)
  reorderQty   Decimal          @default(0) @db.Decimal(12, 2)
  vendorId     String?
  vendor       Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  active       Boolean          @default(true)
  notes        String?
  moves        StockMove[]
  poLines      PurchaseLine[]
}

enum MoveType {
  PURCHASE
  ISSUE
  ADJUST
  RETURN
}

model StockMove {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qty        Decimal  @db.Decimal(12, 2)
  type       MoveType
  ref        String?
  note       String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([materialId, createdAt])
}

model Vendor {
  id        String          @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  gstin     String?
  city      String?
  address   String?
  notes     String?
  createdAt DateTime        @default(now())
  materials Material[]
  pos       PurchaseOrder[]
}

enum PoStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String         @id @default(cuid())
  number     String         @unique
  vendorId   String
  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  status     PoStatus       @default(DRAFT)
  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  gst        Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  createdAt  DateTime       @default(now())
  lines      PurchaseLine[]
}

model PurchaseLine {
  id         String        @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialId String
  material   Material      @relation(fields: [materialId], references: [id])
  qty        Decimal       @db.Decimal(12, 2)
  rate        Decimal       @db.Decimal(10, 2)
  gstRate     Int           @default(18)
  receivedQty Decimal       @default(0) @db.Decimal(12, 2)
}

enum MachineStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum JobStage {
  PREPRESS
  PRINT
  CUT
  FINISH
  PACK
  DONE
}

model Machine {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  kind          String
  stage         JobStage
  status        MachineStatus @default(ACTIVE)
  specs         String?
  lastServiceAt DateTime?
  nextServiceAt DateTime?
  notes         String?
  jobs          Job[]
}

// ---------------------------------------------------------------- sales

enum Channel {
  ONLINE
  B2B
  COUNTER
}

enum OrderStatus {
  PLACED
  PROOF_SENT
  CHANGES_REQUESTED
  APPROVED
  IN_PRODUCTION
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentTerms {
  PREPAID
  PAY_ON_PICKUP
  CREDIT
}

enum Fulfilment {
  PICKUP
  COURIER
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique
  channel       Channel
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  terms         PaymentTerms  @default(PREPAID)
  fulfilment    Fulfilment    @default(COURIER)
  shipName      String?
  shipPhone     String?
  shipLine1     String?
  shipLine2     String?
  shipCity      String?
  shipState     String?
  shipStateCode String?
  shipPincode   String?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  taxable       Decimal       @default(0) @db.Decimal(12, 2)
  cgst          Decimal       @default(0) @db.Decimal(12, 2)
  sgst          Decimal       @default(0) @db.Decimal(12, 2)
  igst          Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  cost          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  notes         String?
  internalNotes String?
  courier       String?
  awb           String?
  rzpOrderId    String?       @unique
  createdById   String?
  placedAt      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  proofs        Proof[]
  invoices      Invoice[]
  payments      Payment[]
  files         FileAsset[]
  quote         Quote?

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  summary   String
  spec      Json?
  qty       Int
  unitPrice Decimal     @db.Decimal(12, 4)
  lineTotal Decimal     @db.Decimal(12, 2)
  lineCost  Decimal     @default(0) @db.Decimal(12, 2)
  hsn       String
  gstRate   Int
  estimate  Json?
  job       Job?
  artwork   FileAsset[]
}

enum ProofStatus {
  SENT
  APPROVED
  CHANGES
}

model Proof {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version     Int
  fileId      String?     @unique
  file        FileAsset?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  note        String
  status      ProofStatus @default(SENT)
  response    String?
  createdById String?
  createdAt   DateTime    @default(now())
  respondedAt DateTime?
}

model Job {
  id              String     @id @default(cuid())
  number          String     @unique
  orderItemId     String     @unique
  orderItem       OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  stage           JobStage   @default(PREPRESS)
  machineId       String?
  machine         Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)
  rush            Boolean    @default(false)
  dueDate         DateTime?
  sheets          Int?
  ups             Int?
  materialsIssued Boolean    @default(false)
  notes           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  events          JobEvent[]

  @@index([stage])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage     JobStage
  note      String?
  userName  String?
  createdAt DateTime @default(now())
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime
  notes       String?
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  taxable     Decimal     @default(0) @db.Decimal(12, 2)
  cgst        Decimal     @default(0) @db.Decimal(12, 2)
  sgst        Decimal     @default(0) @db.Decimal(12, 2)
  igst        Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  cost        Decimal     @default(0) @db.Decimal(12, 2)
  expiredAt   DateTime?
  renewedAt   DateTime?
  orderId     String?     @unique
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  enquiryId   String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       QuoteLine[]
}

model QuoteLine {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  summary   String
  spec      Json?
  qty       Int
  unitPrice Decimal  @db.Decimal(12, 4)
  lineTotal Decimal  @db.Decimal(12, 2)
  lineCost  Decimal  @default(0) @db.Decimal(12, 2)
  hsn       String
  gstRate   Int
  sort      Int      @default(0)
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model Enquiry {
  id         String        @id @default(cuid())
  name       String
  company    String?
  phone      String
  email      String?
  product    String
  qty        String
  details    String
  status     EnquiryStatus @default(NEW)
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
}

// ---------------------------------------------------------------- money

model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  issuedAt      DateTime @default(now())
  dueDate       DateTime
  placeOfSupply String
  interstate    Boolean
  billName      String
  billGstin     String?
  billAddress   String
  lines         Json
  taxable       Decimal  @db.Decimal(12, 2)
  cgst          Decimal  @db.Decimal(12, 2)
  sgst          Decimal  @db.Decimal(12, 2)
  igst          Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  cancelled     Boolean  @default(false)
  createdById   String?
}

enum PayMethod {
  CASH
  UPI
  CARD
  BANK
  CHEQUE
  RAZORPAY
}

model Payment {
  id           String    @id @default(cuid())
  number       String    @unique
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id])
  amount       Decimal   @db.Decimal(12, 2)
  method       PayMethod
  reference    String?
  note         String?
  rzpPaymentId String?   @unique
  receivedAt   DateTime  @default(now())
  createdById  String?
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime  @default(now())
  category    String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  gst         Decimal   @default(0) @db.Decimal(12, 2)
  method      PayMethod @default(BANK)
  reference   String?
  createdById String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------- system

model FileAsset {
  id           String     @id @default(cuid())
  name         String
  mime         String
  size         Int
  path         String
  kind         String     @default("ARTWORK")
  uploadedById String?
  cartToken    String?
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItemId  String?
  orderItem    OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  proof        Proof?

  @@index([productId])
}

model CartLine {
  id         String   @id @default(cuid())
  cartToken  String
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  spec       Json
  artworkIds String[]
  notes      String?
  createdAt  DateTime @default(now())

  @@index([cartToken])
}

model Setting {
  key   String @id
  value Json
}

model Counter {
  key   String @id
  value Int
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  entity    String
  entityId  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
